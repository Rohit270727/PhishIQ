{% extends "base.html" %}
{% block title %}Scan Result - PhishIQ{% endblock %}
{% block content %}
<div class="result-wrapper">
    <div class="result-header verdict-{{ scan.verdict|lower }}">
        <div class="gauge-ring">
            <svg viewBox="0 0 120 120" class="ring-svg">
                <circle cx="60" cy="60" r="52" class="ring-bg"></circle>
                <circle cx="60" cy="60" r="52" class="ring-fg ring-{{ scan.verdict|lower }}"
                        style="stroke-dasharray: {{ (scan.risk_score / 100 * 326.7)|round(1) }} 326.7;">
                </circle>
            </svg>
            <div class="ring-text">
                <div class="gauge-value">{{ scan.risk_score }}</div>
                <div class="gauge-max">/100</div>
            </div>
        </div>
        <div class="verdict-info">
            <span class="badge badge-lg badge-{{ scan.verdict|lower }}">{{ scan.verdict }}</span>
            <p class="scanned-input">{{ scan.input_data }}</p>
            <p class="scan-meta">{{ scan.scan_type|capitalize }} scan &bull; {{ scan.created_at.strftime('%d %b %Y, %I:%M %p') }}</p>
        </div>
    </div>

    <div class="explain-section">
        <div class="primary-reason-banner">
            <strong>Primary reason:</strong> {{ primary_reason }}
        </div>
        <div class="confidence-badge confidence-{{ confidence.label|lower }}">
            Model confidence: {{ confidence.label }}
            {% if confidence.raw_percent is not none %}({{ confidence.raw_percent }}%){% endif %}
            <span class="confidence-note" title="This is a bucketed estimate based on distance from the decision boundary, not a calibrated probability.">&#9432;</span>
        </div>
    </div>

    <div class="flags-section">
        <h2>Signal Breakdown</h2>
        {% if signal_breakdown %}
        <ul class="flags-list">
            {% for reason, points in signal_breakdown %}
            <li class="flag-hit">
                <span class="flag-points">+{{ points }}</span>
                <span class="flag-reason">{{ reason }}</span>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="no-signals">No significant risk signals detected.</p>
        {% endif %}

        {% if notes %}
        <h3 class="notes-heading">Additional Notes</h3>
        <ul class="flags-list flags-notes">
            {% for reason, points in notes %}
            <li class="flag-clean">
                <span class="flag-points">OK</span>
                <span class="flag-reason">{{ reason }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>

    <div class="flags-section" id="ioc-graph-section">
        <h2>Infrastructure Correlation</h2>
        {% if graph_data and graph_data.nodes and graph_data.nodes|length > 1 %}
        <p class="page-subtitle" style="margin-bottom:16px;">Domains, IPs, and networks this scan shares infrastructure with, based on PhishIQ's own scan history.</p>
        <svg id="ioc-graph-svg" viewBox="0 0 700 500" style="width:100%; max-width:700px; display:block; margin:0 auto; background:var(--bg-primary); border:1px solid var(--border-color); border-radius:8px;"></svg>
        <script id="ioc-graph-data" type="application/json">{{ graph_data | tojson }}</script>
        <script>
        (function () {
            const data = JSON.parse(document.getElementById('ioc-graph-data').textContent);
            const svg = document.getElementById('ioc-graph-svg');
            const cx = 350, cy = 250, radius = 170;
            const nodeColors = {
                center: '#00d9a3',
                domain: '#8a94a8',
                dangerous_domain: '#ff4757',
                ip: '#00d9a3',
                asn: '#ffb020'
            };

            const centerNode = data.nodes.find(n => n.kind === 'center');
            const otherNodes = data.nodes.filter(n => n.kind !== 'center');
            const positions = {};
            positions[centerNode.id] = { x: cx, y: cy };

            otherNodes.forEach((n, i) => {
                const angle = (2 * Math.PI * i) / Math.max(otherNodes.length, 1);
                positions[n.id] = {
                    x: cx + radius * Math.cos(angle),
                    y: cy + radius * Math.sin(angle)
                };
            });

            const ns = 'http://www.w3.org/2000/svg';
            data.edges.forEach(edge => {
                const a = positions[edge.source];
                const b = positions[edge.target];
                if (!a || !b) return;
                const line = document.createElementNS(ns, 'line');
                line.setAttribute('x1', a.x);
                line.setAttribute('y1', a.y);
                line.setAttribute('x2', b.x);
                line.setAttribute('y2', b.y);
                line.setAttribute('stroke', '#2a3448');
                line.setAttribute('stroke-width', '1.5');
                svg.appendChild(line);
            });

            data.nodes.forEach(n => {
                const pos = positions[n.id];
                if (!pos) return;
                const isCenter = n.kind === 'center';
                const r = isCenter ? 26 : (n.kind === 'ip' || n.kind === 'asn' ? 18 : 14);

                const circle = document.createElementNS(ns, 'circle');
                circle.setAttribute('cx', pos.x);
                circle.setAttribute('cy', pos.y);
                circle.setAttribute('r', r);
                circle.setAttribute('fill', nodeColors[n.kind] || '#8a94a8');
                circle.setAttribute('fill-opacity', isCenter ? '1' : '0.85');
                circle.setAttribute('stroke', '#1a2233');
                circle.setAttribute('stroke-width', '2');
                svg.appendChild(circle);

                const label = document.createElementNS(ns, 'text');
                label.setAttribute('x', pos.x);
                label.setAttribute('y', pos.y + r + 14);
                label.setAttribute('text-anchor', 'middle');
                label.setAttribute('fill', '#e8ecf4');
                label.setAttribute('font-size', '11');
                label.textContent = n.label.length > 22 ? n.label.slice(0, 20) + '…' : n.label;
                svg.appendChild(label);
            });
        })();
        </script>
        {% else %}
        <p class="no-signals">No shared infrastructure found with previously-scanned domains.</p>
        {% endif %}
    </div>

    <div class="feedback-section">
        <h2>Was this result accurate?</h2>
        <div class="feedback-buttons" data-scan-id="{{ scan.id }}">
            <button type="button" class="feedback-btn feedback-correct {{ 'active' if feedback_type == 'correct' else '' }}" data-type="correct">
                &#128077; Correct
            </button>
            <button type="button" class="feedback-btn feedback-fp {{ 'active' if feedback_type == 'false_positive' else '' }}" data-type="false_positive">
                &#128078; False Positive
            </button>
            <button type="button" class="feedback-btn feedback-fn {{ 'active' if feedback_type == 'false_negative' else '' }}" data-type="false_negative">
                &#9888; Missed Threat
            </button>
        </div>
        <p class="feedback-confirm" style="display:none;">Thanks for the feedback!</p>
    </div>

    {% if scan.scan_type == 'url' %}
    <div class="deep-scan-section">
        <form method="POST" action="{{ url_for('deep_scan', scan_id=scan.id) }}" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='Running Deep Scan (this may take a few seconds)...';">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn btn-secondary btn-block">Run Deep Scan (Visual Brand Check)</button>
        </form>
    </div>
    {% endif %}
    <div class="result-actions">
        <a href="{{ url_for('download_report', scan_id=scan.id) }}" class="btn btn-secondary">Download PDF Report</a>
        <a href="{{ url_for('scan_url') if scan.scan_type == 'url' else (url_for('scan_qr') if scan.scan_type == 'qr' else url_for('scan_message')) }}" class="btn btn-secondary">Scan Another</a>
        <a href="{{ url_for('dashboard') }}" class="btn btn-primary">Back to Dashboard</a>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const container = document.querySelector(".feedback-buttons");
    if (!container) return;

    const scanId = container.dataset.scanId;
    const confirmMsg = document.querySelector(".feedback-confirm");

    container.querySelectorAll(".feedback-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const feedbackType = btn.dataset.type;

            fetch(`/scan/${scanId}/feedback`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRFToken": "{{ csrf_token() }}"
                },
                body: JSON.stringify({ feedback_type: feedbackType })
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    container.querySelectorAll(".feedback-btn").forEach(function (b) {
                        b.classList.remove("active");
                    });
                    btn.classList.add("active");
                    if (confirmMsg) {
                        confirmMsg.style.display = "block";
                        setTimeout(function () { confirmMsg.style.display = "none"; }, 2500);
                    }
                } else {
                    alert(data.error || "Could not save feedback.");
                }
            })
            .catch(function () {
                alert("Network error saving feedback.");
            });
        });
    });
});
</script>
{% endblock %}
