@app.route("/deep-scan/<int:scan_id>", methods=["POST"])
@login_required
def deep_scan(scan_id):
    scan = ScanHistory.query.filter_by(id=scan_id, user_id=session["user_id"]).first()
    if not scan or scan.scan_type != "url":
        flash("Deep scan is only available for URL scans.", "error")
        return redirect(url_for("dashboard"))

    domain = urlparse(scan.input_data if re.match(r"^https?://", scan.input_data, re.IGNORECASE) else "http://" + scan.input_data).netloc.lower()
    url_to_check = scan.input_data if re.match(r"^https?://", scan.input_data, re.IGNORECASE) else "http://" + scan.input_data

    result = check_visual_similarity(url_to_check, domain)

    flags = json.loads(scan.flags)
    if result:
        flags.append((result["message"], 20))
        new_score = min(scan.risk_score + 20, 100)
        scan.risk_score = new_score
        if new_score >= 61:
            scan.verdict = "Dangerous"
        elif new_score >= 31:
            scan.verdict = "Suspicious"
    else:
        flags.append(("Deep scan: no visual brand impersonation detected", 0))

    scan.flags = json.dumps(flags)
    db.session.commit()

    return redirect(url_for("result", scan_id=scan.id))


