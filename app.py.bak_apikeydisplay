@app.route("/scan/message", methods=["GET", "POST"])
@login_required
def scan_message():
    if request.method == "POST":
        text = request.form.get("message", "").strip()

        uploaded_file = request.files.get("message_file")
        if uploaded_file and uploaded_file.filename != "":
            filename = uploaded_file.filename
            ext = filename.rsplit(".", 1)[-1].lower() if "." in filename else ""

            if ext not in ("txt", "eml", "pdf"):
                flash("Please upload a .txt, .eml, or .pdf file.", "error")
                return redirect(url_for("scan_message"))

            safe_name = secure_filename(f"{session['user_id']}_{filename}")
            upload_dir = os.path.join("static", "message_uploads")
            os.makedirs(upload_dir, exist_ok=True)
            filepath = os.path.join(upload_dir, safe_name)
            uploaded_file.save(filepath)

            try:
                extracted = extract_text_from_file(filepath, ext)
            except Exception:
                flash("Could not read that file. Please try a different one.", "error")
                return redirect(url_for("scan_message"))

            if extracted and extracted.strip():
                text = extracted.strip()

            sender_domain = None
            eml_filepath = None
            if ext == "eml":
                from detectors.file_extractor import extract_sender_domain
                sender_domain = extract_sender_domain(filepath, ext)
                eml_filepath = filepath

        if not text:
            flash("Please enter a message or upload a file.", "error")
            return redirect(url_for("scan_message"))

        result = analyze_message(
            text,
            sender_domain=locals().get("sender_domain"),
            eml_filepath=locals().get("eml_filepath")
        )
        scan = ScanHistory(
            user_id=session["user_id"],
            scan_type="message",
            input_data=text,
            risk_score=result["score"],
            verdict=result["verdict"],
            flags=json.dumps(result["flags"])
        )
        db.session.add(scan)
        db.session.commit()
        return redirect(url_for("result", scan_id=scan.id))

    return render_template("scan_message.html")



