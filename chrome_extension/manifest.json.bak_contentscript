{
  "manifest_version": 3,
  "name": "PhishIQ - Phishing Detector",
  "version": "1.0.0",
  "description": "Scan the current website for phishing indicators using PhishIQ.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
